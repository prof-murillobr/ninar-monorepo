# EC2-only production template. S3 and SQS are emulated by LocalStack below.
NODE_ENV=production
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
S3_ENDPOINT=http://localstack:4566
S3_PUBLIC_ENDPOINT=https://storage.ninar.example.com
S3_BUCKET=ninar-audio
SQS_QUEUE_URL=http://localstack:4566/000000000000/analyses
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
POSTGRES_DB=ninar
POSTGRES_USER=ninar
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_URL=postgres://ninar:replace_with_url_encoded_password@postgres:5432/ninar
REDIS_URL=redis://redis:6379
HF_TOKEN=
HF_MODEL_ID=dontcryai/dontcry
HF_MODEL_REVISION=158d507a8e19afeedb983f5ca25396453ac1c92b
HF_BASE_MODEL_REVISION=dba3bb02fda4248b6e082697eee756de8fe8aa8a
CLASSIFIER_URL=http://inference:8000
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
CORS_ORIGIN=https://ninar.example.com
NEXT_PUBLIC_API_URL=https://api.ninar.example.com

# Existing Caddy / TLS
WEB_DOMAIN=ninar.example.com
API_DOMAIN=api.ninar.example.com
STORAGE_DOMAIN=storage.ninar.example.com
ACME_EMAIL=you@example.com
