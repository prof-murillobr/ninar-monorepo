# Template production: use Secret Manager/SSM or a Kubernetes Secret manager.
NODE_ENV=production
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
AWS_EC2_METADATA_DISABLED=false
S3_BUCKET=replace_with_a_globally_unique_bucket_name
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/replace_with_account_id/ninar-analyses
POSTGRES_DB=ninar
POSTGRES_USER=ninar
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_URL=postgres://ninar:replace_with_url_encoded_password@postgres:5432/ninar
REDIS_URL=redis://redis:6379
HF_TOKEN=
HF_MODEL_ID=dontcryai/dontcry
HF_MODEL_REVISION=158d507a8e19afeedb983f5ca25396453ac1c92b
HF_BASE_MODEL_REVISION=dba3bb02fda4248b6e082697eee756de8fe8aa8a
CLASSIFIER_URL=http://inference:8000
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
CORS_ORIGIN=https://ninar.example.com
NEXT_PUBLIC_API_URL=https://api.ninar.example.com

# Host Caddy / TLS
WEB_DOMAIN=ninar.example.com
API_DOMAIN=api.ninar.example.com
ACME_EMAIL=you@example.com
