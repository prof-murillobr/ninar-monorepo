# Caddy already runs in the personal-site Docker Compose project.
# Add these site blocks to its existing Caddyfile. The Caddy container must
# also join the external Docker network named ninar_edge.

ninar-app.com {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy ninar-web:3000
}

api.ninar-app.com {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy ninar-api:3001
}

storage.ninar-app.com {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
  }

  reverse_proxy ninar-storage:4566 {
    header_up Host {http.request.host}
  }
}

analytics.ninar-app.com {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy ninar-analytics:3000
}
