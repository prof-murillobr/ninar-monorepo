# Homologação AWS + k3s. Copie para .env.hml; nunca commite o arquivo preenchido.
NODE_ENV=production
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ENDPOINT_URL=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
AWS_EC2_METADATA_DISABLED=false

# Saídas do Terraform
S3_BUCKET=ninar-hml-audio-ACCOUNT_ID
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/ninar-hml-analyses
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/ninar-hml-analyses-dlq

# Banco/cache no k3s MVP
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_URL=postgres://ninar:troque-por-uma-senha-forte@postgres:5432/ninar
REDIS_URL=redis://redis:6379

# Modelo privado; use um token read-only e prefira Secret Manager/SSM em produção.
HF_TOKEN=replace_with_a_read_only_huggingface_token
HF_MODEL_ID=dontcryai/dontcry
HF_MODEL_REVISION=158d507a8e19afeedb983f5ca25396453ac1c92b
HF_BASE_MODEL_REVISION=dba3bb02fda4248b6e082697eee756de8fe8aa8a
CLASSIFIER_URL=http://inference:8000
WORKER_ENABLED=true

# Frontend público (build-time do Next.js)
NEXT_PUBLIC_API_URL=https://api.ninar.example.com
ECR_IMAGE_TAG=latest

# Opcional: credenciais estáticas somente para laboratório.
# Prefira a IAM Role da EC2 e deixe vazios no ambiente real.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
