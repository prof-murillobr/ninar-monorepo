# EC2-only production template. S3 and SQS are emulated by Floci below.
NODE_ENV=production
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://floci:4566
S3_ENDPOINT=http://floci:4566
S3_PUBLIC_ENDPOINT=https://storage.ninar-app.com
S3_BUCKET=ninar-audio
SQS_QUEUE_URL=http://floci:4566/000000000000/analyses
MULTIPART_THRESHOLD_BYTES=8388608
MULTIPART_PART_SIZE_BYTES=5242880
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
POSTGRES_DB=ninar
POSTGRES_USER=ninar
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_URL=postgres://ninar:replace_with_url_encoded_password@postgres:5432/ninar
REDIS_URL=redis://redis:6379
HF_TOKEN=
HF_MODEL_ID=dontcryai/dontcry
HF_MODEL_REVISION=158d507a8e19afeedb983f5ca25396453ac1c92b
HF_BASE_MODEL_REVISION=dba3bb02fda4248b6e082697eee756de8fe8aa8a
CLASSIFIER_URL=http://inference:8000
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
CORS_ORIGIN=https://ninar-app.com
NEXT_PUBLIC_API_URL=https://api.ninar-app.com
NEXT_PUBLIC_UMAMI_HOST_URL=https://analytics.ninar-app.com
# Crie o site ninar-app.com no Umami e informe o UUID do website.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_DB_PASSWORD=replace_with_a_long_alphanumeric_password
# Gere com: openssl rand -hex 32
UMAMI_APP_SECRET=replace_with_64_random_hex_characters
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=replace_with_64_random_hex_characters

# Existing Caddy / TLS
WEB_DOMAIN=ninar-app.com
API_DOMAIN=api.ninar-app.com
STORAGE_DOMAIN=storage.ninar-app.com
ANALYTICS_DOMAIN=analytics.ninar-app.com
ACME_EMAIL=you@example.com
